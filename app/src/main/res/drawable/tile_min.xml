<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- фокус: матовое белое стекло -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:type="linear" android:angle="315"
                android:startColor="#F7FFFFFF" android:endColor="#E0EDF6FF" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
        </shape>
    </item>
    <!-- покой: стекло с лёгкой заливкой и внутренним бликом -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:type="linear" android:angle="315"
                        android:startColor="#38FFFFFF" android:endColor="#12FFFFFF" />
                    <corners android:radius="26dp" />
                    <stroke android:width="1dp" android:color="#4DFFFFFF" />
                </shape>
            </item>
            <item android:top="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <gradient android:type="linear" android:angle="270"
                        android:startColor="#1FFFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="25dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>